{
  "manifest_version": 3,
  "name": "NeverLate — Plaksha Deadline Tracker",
  "version": "2.4.3",
  "description": "Track assignments, quizzes, and exams with calm countdowns and reminders on Plaksha LMS.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NeverLate — Plaksha Deadline Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://lms.plaksha.edu.in/*",
    "https://dle.plaksha.edu.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lms.plaksha.edu.in/*",
        "https://dle.plaksha.edu.in/*"
      ],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
